[Unit]
Description=Neo4j Eletrometry (Docker)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/docker start eletrometry-neo4j
ExecStop=/usr/bin/docker stop --time 60 eletrometry-neo4j
TimeoutStartSec=180
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
